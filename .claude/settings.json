{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "venv/bin/ruff format --diff vchat/ jobs/"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT_COMMAND\" | grep -qiE 'Co-Authored-By'; then echo 'ERROR: Co-Authored-By forbidden in commits' >&2; exit 1; fi"
          }
        ]
      }
    ]
  }
}
