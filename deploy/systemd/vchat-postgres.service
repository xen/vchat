[Unit]
Description=vchat ParadeDB PostgreSQL 18
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=deploy
Group=deploy
EnvironmentFile=/var/www/vchat/postgres.env
ExecStartPre=-/usr/bin/docker rm -f vchat-postgres
ExecStart=/usr/bin/docker run --rm --name vchat-postgres --network host --env-file /var/www/vchat/postgres.env -v /var/www/vchat/postgres:/var/lib/postgresql paradedb/paradedb:0.25.6 -c max_connections=50 -c shared_buffers=8GB -c effective_cache_size=24GB -c maintenance_work_mem=1GB -c work_mem=32MB -c huge_pages=try -c checkpoint_completion_target=0.9 -c min_wal_size=2GB -c max_wal_size=8GB -c random_page_cost=1.1 -c effective_io_concurrency=200
ExecStop=/usr/bin/docker stop --time 120 vchat-postgres
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
